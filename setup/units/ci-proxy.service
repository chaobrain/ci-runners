# The CI proxy: a separate instance of the host's proxy client, with its own config
# copy, node and local ports (lead decision 5, §12 item 4). The interactive proxy is
# left alone. ci-proxy-check.timer switches the node after 3 failed checks.
[Unit]
Description=ci-runners: CI proxy

[Service]
ExecStart=@PROXY_CLIENT@ run -c @CI_ETC@/proxy/active.json -c @CI_ETC@/proxy/routing.json
NoNewPrivileges=yes
Restart=always
RestartSec=5
Slice=ci.slice

[Install]
WantedBy=default.target
