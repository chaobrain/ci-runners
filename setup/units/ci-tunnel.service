# h100's egress (design decision 11.8): ssh with dynamic forwarding (SOCKS5 on
# 127.0.0.1) to the egress host's restricted account. etc/tunnel/ssh_config says only
# "Host egress" with its HostName, User and Port (setup refuses anything else); the key,
# the pinned host key, the forwarding and every option a config could loosen are fixed
# here. ci-bridge.service is in front.
[Unit]
Description=ci-runners: egress tunnel

[Service]
ExecStart=/usr/bin/ssh -F @CI_ETC@/tunnel/ssh_config -N -D 127.0.0.1:@TUNNEL_SOCKS@ -o BatchMode=yes -o IdentitiesOnly=yes -o IdentityFile=@CI_ETC@/tunnel/id_ed25519 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=@CI_ETC@/tunnel/known_hosts -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o GlobalKnownHostsFile=/dev/null -o KnownHostsCommand=none -o VerifyHostKeyDNS=no -o CheckHostIP=no -o UpdateHostKeys=no -o GatewayPorts=no -o PermitLocalCommand=no -o IdentityAgent=none -o ControlMaster=no -o ControlPath=none -o ForwardAgent=no -o ForwardX11=no -o ConnectTimeout=20 egress
NoNewPrivileges=yes
Restart=always
RestartSec=10
Slice=ci.slice

[Install]
WantedBy=default.target
