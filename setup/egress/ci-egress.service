# The egress proxy (design decision 11.10, §5.3): a system unit of the egress host,
# installed by root from a root-owned release. HTTP CONNECT on 127.0.0.1:18443 to the
# allowlist's names on port 443, connected directly; h100's ci-tunnel.service forwards
# its local port here, and the egress account's key opens this one port. The port must
# match the inventory's tunnel.egress_port and the key's permitopen.
[Unit]
Description=ci-runners: egress proxy
After=network-online.target
Wants=network-online.target

[Service]
# a transient user of its own: the proxy needs no account, and the egress account's
# key only reaches this port
DynamicUser=yes
ExecStart=/opt/ci-runners/releases/hook/bin/ci-run egress --port 18443 --allow /opt/ci-runners/etc/egress-allow
Environment=CI_RUNNERS_PYTHON=/usr/bin/python3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
# decision 17: at most 1024 connections (ci-run egress --max-connections, its default);
# two descriptors each plus the listener, stdio, epoll, the loop's self-pipe and up to 32
# name lookups: 2 x 1024 + 39 = 2087, so 4096 leaves room for refusals in flight. Memory:
# about 15 KiB an idle connection, about 455 KiB one whose client stops reading while its
# far end sends (measured, resident), 1024 x 455 KiB = 455 MiB plus the interpreter and
# the kernel's socket buffers, so 1G. Tasks:
# one thread runs every connection; name lookups take at most 32 more.
LimitNOFILE=4096
MemoryMax=1G
TasksMax=128
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
