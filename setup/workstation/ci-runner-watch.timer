# Every quarter hour, at :00, :15, :30 and :45 UTC (design decision 15.5): two consecutive
# checks with no runner of a host online open its issue. Exact (no random delay); a host that
# was down does not catch up (not Persistent).
[Unit]
Description=ci-runners: the runner watch, every quarter hour

[Timer]
OnCalendar=*-*-* *:00,15,30,45:00 UTC
AccuracySec=1s

[Install]
WantedBy=timers.target
