# /etc/tmpfiles.d/ci-runners.conf (design §5.3, the dedicated CI account): the host's
# lock and slot files (D5) are shared by @MAINTAINER@ and @CI_ACCOUNT@. /tmp is emptied at
# boot and fs.protected_regular=2 refuses O_CREAT on another account's file there, so
# they are root-owned, with ACL entries for both accounts, and never age-cleaned.
f @HOST_LOCK@ 0664 root root -
f @HOST_LOCK_STEM@.turnstile.lock 0664 root root -
f @HOST_LOCK_STEM@.shared.lock 0664 root root -
f @SLOT_LOCK@ 0664 root root -
f @SLOT_LOCK_STEM@.2.lock 0664 root root -
a+ @HOST_LOCK@ - - - - u:@MAINTAINER@:rw,u:@CI_ACCOUNT@:rw
a+ @HOST_LOCK_STEM@.turnstile.lock - - - - u:@MAINTAINER@:rw,u:@CI_ACCOUNT@:rw
a+ @HOST_LOCK_STEM@.shared.lock - - - - u:@MAINTAINER@:rw,u:@CI_ACCOUNT@:rw
a+ @SLOT_LOCK@ - - - - u:@MAINTAINER@:rw,u:@CI_ACCOUNT@:rw
a+ @SLOT_LOCK_STEM@.2.lock - - - - u:@MAINTAINER@:rw,u:@CI_ACCOUNT@:rw
d @SLOT_QUEUE@ 0775 @MAINTAINER@ @MAINTAINER@ -
a+ @SLOT_QUEUE@ - - - - u:@CI_ACCOUNT@:rwx,d:u:@CI_ACCOUNT@:rwx,d:u:@MAINTAINER@:rwx
x @HOST_LOCK_STEM@*.lock
x @SLOT_LOCK_STEM@*
