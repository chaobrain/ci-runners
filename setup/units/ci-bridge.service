# h100's egress bridge (design decision 11.8): HTTP CONNECT on 127.0.0.1 to the
# inventory's allowlisted names on port 443, through ci-tunnel's SOCKS5 port. The
# runners' https_proxy points here.
[Unit]
Description=ci-runners: egress bridge
After=ci-tunnel.service
Wants=ci-tunnel.service

[Service]
ExecStart=@CI_DATA@/ci-runners/releases/hook/bin/ci-run bridge
Environment=CI_RUNNERS_ETC=@CI_ETC@
Environment=CI_RUNNERS_PYTHON=@CI_PYTHON@
# the tunnel table's digest: a changed allowlist or port changes this file (setup restarts it)
Environment=CI_TUNNEL=@TUNNEL_DIGEST@
NoNewPrivileges=yes
Restart=always
RestartSec=5
Slice=ci.slice

[Install]
WantedBy=default.target
