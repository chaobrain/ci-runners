# One GitHub Actions runner, <data>/actions-runner/%i (design §5.3). The pre-job hook,
# set in the runner's .env, is the boundary; NoNewPrivileges makes sudo fail (D4). It
# starts after the CI proxy where the host has one, and on a 3090 host only with the
# hooks' copies in the account's private /tmp (decision 13.5). A failed start (the copy
# not done yet) is retried every 30 s, never given up (decision 15.5).
[Unit]
Description=ci-runners: GitHub Actions runner %i
StartLimitIntervalSec=0
@PROXY_ORDER@
@HOOKS_ORDER@

[Service]
WorkingDirectory=@CI_DATA@/actions-runner/%i
# Presence (decision 16.4): while the runner's resource cannot start a job, the check ends
# 77 and the start is skipped (Result=exec-condition; the presence tick starts it later).
# Any other end, an error or an older release without the check, lets the runner start.
ExecCondition=/bin/sh -c 'CI_RUNNERS_ETC=@CI_ETC@ CI_RUNNERS_PYTHON=@CI_PYTHON@ @CI_DATA@/ci-runners/releases/hook/bin/ci-run presence check "$$1"; test $$? -ne 77' presence %i
@HOOKS_CHECK@
ExecStart=@CI_DATA@/actions-runner/%i/run.sh
NoNewPrivileges=yes
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5min
Restart=always
RestartSec=30
Slice=ci.slice

[Install]
WantedBy=default.target
